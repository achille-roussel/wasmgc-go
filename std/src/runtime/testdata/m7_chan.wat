;; M7 channel driver (docs/design/04, 09).
;; Waiter queues, write-before-ready, buffered ring. No 1 ms polling.
;; Imports match go.runtime.*; run_m7.mjs uses lib/wasmgc.js (JSPI).
(module
  (import "go" "runtime.park" (func $park (param i32) (result i32)))
  (import "go" "runtime.ready" (func $ready (param i32)))
  (import "go" "runtime.spawn" (func $spawn))

  (type $go.object (sub (struct)))
  (type $i32arr (array (mut i32)))

  (rec
    (type $waiter (sub $go.object (struct
      (field $park (mut i32))
      (field $elem (mut i32))
      (field $has  (mut i32))
      (field $next (mut (ref null $waiter))))))

    (type $hchan (sub $go.object (struct
      (field $qcount   (mut i32))
      (field $cap      i32)
      (field $sendx    (mut i32))
      (field $recvx    (mut i32))
      (field $closed   (mut i32))
      (field $sendHead (mut (ref null $waiter)))
      (field $sendTail (mut (ref null $waiter)))
      (field $recvHead (mut (ref null $waiter)))
      (field $recvTail (mut (ref null $waiter)))
      (field $buf      (ref null $i32arr)))))
  )

  (global $parkGen (mut i32) (i32.const 1))
  (global $job (mut i32) (i32.const 0))
  (global $chan (mut (ref null $hchan)) (ref.null $hchan))

  (func $mint (result i32)
    (local $id i32)
    (local.set $id (global.get $parkGen))
    (global.set $parkGen (i32.add (local.get $id) (i32.const 1)))
    (local.get $id))

  (func $enqRecv (param $c (ref $hchan)) (param $w (ref $waiter))
    (local $t (ref null $waiter))
    (local.set $t (struct.get $hchan $recvTail (local.get $c)))
    (if (ref.is_null (local.get $t))
      (then
        (struct.set $hchan $recvHead (local.get $c) (local.get $w))
        (struct.set $hchan $recvTail (local.get $c) (local.get $w)))
      (else
        (struct.set $waiter $next (ref.as_non_null (local.get $t)) (local.get $w))
        (struct.set $hchan $recvTail (local.get $c) (local.get $w)))))

  (func $enqSend (param $c (ref $hchan)) (param $w (ref $waiter))
    (local $t (ref null $waiter))
    (local.set $t (struct.get $hchan $sendTail (local.get $c)))
    (if (ref.is_null (local.get $t))
      (then
        (struct.set $hchan $sendHead (local.get $c) (local.get $w))
        (struct.set $hchan $sendTail (local.get $c) (local.get $w)))
      (else
        (struct.set $waiter $next (ref.as_non_null (local.get $t)) (local.get $w))
        (struct.set $hchan $sendTail (local.get $c) (local.get $w)))))

  (func $deqRecv (param $c (ref $hchan)) (result (ref null $waiter))
    (local $w (ref null $waiter))
    (local.set $w (struct.get $hchan $recvHead (local.get $c)))
    (if (ref.is_null (local.get $w)) (then (return (ref.null $waiter))))
    (struct.set $hchan $recvHead (local.get $c)
      (struct.get $waiter $next (ref.as_non_null (local.get $w))))
    (if (ref.is_null (struct.get $hchan $recvHead (local.get $c)))
      (then (struct.set $hchan $recvTail (local.get $c) (ref.null $waiter))))
    (struct.set $waiter $next (ref.as_non_null (local.get $w)) (ref.null $waiter))
    (local.get $w))

  (func $deqSend (param $c (ref $hchan)) (result (ref null $waiter))
    (local $w (ref null $waiter))
    (local.set $w (struct.get $hchan $sendHead (local.get $c)))
    (if (ref.is_null (local.get $w)) (then (return (ref.null $waiter))))
    (struct.set $hchan $sendHead (local.get $c)
      (struct.get $waiter $next (ref.as_non_null (local.get $w))))
    (if (ref.is_null (struct.get $hchan $sendHead (local.get $c)))
      (then (struct.set $hchan $sendTail (local.get $c) (ref.null $waiter))))
    (struct.set $waiter $next (ref.as_non_null (local.get $w)) (ref.null $waiter))
    (local.get $w))

  (func $chansend (param $c (ref $hchan)) (param $v i32) (param $block i32) (result i32)
    (local $w (ref null $waiter))
    (local $ww (ref $waiter))
    (local $id i32)
    (local $buf (ref $i32arr))
    (local $sx i32)
    (if (struct.get $hchan $closed (local.get $c)) (then (unreachable)))
    (local.set $w (call $deqRecv (local.get $c)))
    (if (i32.eqz (ref.is_null (local.get $w)))
      (then
        (local.set $ww (ref.as_non_null (local.get $w)))
        ;; write-before-ready
        (struct.set $waiter $elem (local.get $ww) (local.get $v))
        (struct.set $waiter $has (local.get $ww) (i32.const 1))
        (call $ready (struct.get $waiter $park (local.get $ww)))
        (return (i32.const 1))))
    (if (i32.lt_u (struct.get $hchan $qcount (local.get $c))
                   (struct.get $hchan $cap (local.get $c)))
      (then
        (local.set $buf (ref.as_non_null (struct.get $hchan $buf (local.get $c))))
        (local.set $sx (struct.get $hchan $sendx (local.get $c)))
        (array.set $i32arr (local.get $buf) (local.get $sx) (local.get $v))
        (local.set $sx (i32.add (local.get $sx) (i32.const 1)))
        (if (i32.eq (local.get $sx) (struct.get $hchan $cap (local.get $c)))
          (then (local.set $sx (i32.const 0))))
        (struct.set $hchan $sendx (local.get $c) (local.get $sx))
        (struct.set $hchan $qcount (local.get $c)
          (i32.add (struct.get $hchan $qcount (local.get $c)) (i32.const 1)))
        (return (i32.const 1))))
    (if (i32.eqz (local.get $block)) (then (return (i32.const 0))))
    (local.set $id (call $mint))
    (local.set $ww
      (struct.new $waiter
        (local.get $id) (local.get $v) (i32.const 1) (ref.null $waiter)))
    (call $enqSend (local.get $c) (local.get $ww))
    (drop (call $park (local.get $id)))
    (if (struct.get $hchan $closed (local.get $c)) (then (unreachable)))
    (i32.const 1))

  (func $chanrecv (param $c (ref $hchan)) (param $block i32) (result i32 i32)
    (local $w (ref null $waiter))
    (local $ww (ref $waiter))
    (local $id i32)
    (local $buf (ref $i32arr))
    (local $rx i32)
    (local $v i32)
    (local.set $w (call $deqSend (local.get $c)))
    (if (i32.eqz (ref.is_null (local.get $w)))
      (then
        (local.set $ww (ref.as_non_null (local.get $w)))
        (if (i32.eqz (struct.get $hchan $cap (local.get $c)))
          (then
            (local.set $v (struct.get $waiter $elem (local.get $ww)))
            (call $ready (struct.get $waiter $park (local.get $ww)))
            (return (local.get $v) (i32.const 1))))
        (local.set $buf (ref.as_non_null (struct.get $hchan $buf (local.get $c))))
        (local.set $rx (struct.get $hchan $recvx (local.get $c)))
        (local.set $v (array.get $i32arr (local.get $buf) (local.get $rx)))
        (array.set $i32arr (local.get $buf)
          (struct.get $hchan $sendx (local.get $c))
          (struct.get $waiter $elem (local.get $ww)))
        (local.set $rx (i32.add (local.get $rx) (i32.const 1)))
        (if (i32.eq (local.get $rx) (struct.get $hchan $cap (local.get $c)))
          (then (local.set $rx (i32.const 0))))
        (struct.set $hchan $recvx (local.get $c) (local.get $rx))
        (local.set $rx (i32.add (struct.get $hchan $sendx (local.get $c)) (i32.const 1)))
        (if (i32.eq (local.get $rx) (struct.get $hchan $cap (local.get $c)))
          (then (local.set $rx (i32.const 0))))
        (struct.set $hchan $sendx (local.get $c) (local.get $rx))
        (call $ready (struct.get $waiter $park (local.get $ww)))
        (return (local.get $v) (i32.const 1))))
    (if (i32.gt_u (struct.get $hchan $qcount (local.get $c)) (i32.const 0))
      (then
        (local.set $buf (ref.as_non_null (struct.get $hchan $buf (local.get $c))))
        (local.set $rx (struct.get $hchan $recvx (local.get $c)))
        (local.set $v (array.get $i32arr (local.get $buf) (local.get $rx)))
        (local.set $rx (i32.add (local.get $rx) (i32.const 1)))
        (if (i32.eq (local.get $rx) (struct.get $hchan $cap (local.get $c)))
          (then (local.set $rx (i32.const 0))))
        (struct.set $hchan $recvx (local.get $c) (local.get $rx))
        (struct.set $hchan $qcount (local.get $c)
          (i32.sub (struct.get $hchan $qcount (local.get $c)) (i32.const 1)))
        (return (local.get $v) (i32.const 1))))
    (if (struct.get $hchan $closed (local.get $c))
      (then (return (i32.const 0) (i32.const 0))))
    (if (i32.eqz (local.get $block)) (then (return (i32.const 0) (i32.const 0))))
    (local.set $id (call $mint))
    (local.set $ww
      (struct.new $waiter (local.get $id) (i32.const 0) (i32.const 0) (ref.null $waiter)))
    (call $enqRecv (local.get $c) (local.get $ww))
    (drop (call $park (local.get $id)))
    (if (i32.eqz (struct.get $waiter $has (local.get $ww)))
      (then (return (i32.const 0) (i32.const 0))))
    (return (struct.get $waiter $elem (local.get $ww)) (i32.const 1)))

  (func $makechan (param $cap i32) (result (ref $hchan))
    (local $buf (ref null $i32arr))
    (if (i32.gt_u (local.get $cap) (i32.const 0))
      (then (local.set $buf (array.new_default $i32arr (local.get $cap)))))
    (struct.new $hchan
      (i32.const 0) (local.get $cap)
      (i32.const 0) (i32.const 0) (i32.const 0)
      (ref.null $waiter) (ref.null $waiter)
      (ref.null $waiter) (ref.null $waiter)
      (local.get $buf)))

  (func $chanclose (param $c (ref $hchan))
    (local $w (ref null $waiter))
    (if (struct.get $hchan $closed (local.get $c)) (then (unreachable)))
    (struct.set $hchan $closed (local.get $c) (i32.const 1))
    (block $doneR
      (loop $loopR
        (local.set $w (call $deqRecv (local.get $c)))
        (br_if $doneR (ref.is_null (local.get $w)))
        (call $ready (struct.get $waiter $park (ref.as_non_null (local.get $w))))
        (br $loopR)))
    (block $doneS
      (loop $loopS
        (local.set $w (call $deqSend (local.get $c)))
        (br_if $doneS (ref.is_null (local.get $w)))
        (call $ready (struct.get $waiter $park (ref.as_non_null (local.get $w))))
        (br $loopS))))

  ;; run / _sched required by glue spawn.
  (func (export "run") (nop))

  (func (export "_sched")
    (local $c (ref $hchan))
    (local.set $c (ref.as_non_null (global.get $chan)))
    (if (i32.eq (global.get $job) (i32.const 1))
      (then
        (drop (call $chansend (local.get $c) (i32.const 42) (i32.const 1)))
        (global.set $job (i32.const 0))
        (return)))
    (if (i32.eq (global.get $job) (i32.const 2))
      (then
        (drop (call $chansend (local.get $c) (i32.const 10) (i32.const 1)))
        (drop (call $chansend (local.get $c) (i32.const 20) (i32.const 1)))
        (global.set $job (i32.const 0))
        (return)))
    (if (i32.eq (global.get $job) (i32.const 3))
      (then
        (call $chanclose (local.get $c))
        (global.set $job (i32.const 0))
        (return))))

  ;; Buffered send/recv without parking.
  (func (export "buffered_send_recv") (result i32)
    (local $c (ref $hchan))
    (local $v i32)
    (local $ok i32)
    (local.set $c (call $makechan (i32.const 1)))
    (drop (call $chansend (local.get $c) (i32.const 7) (i32.const 1)))
    (call $chanrecv (local.get $c) (i32.const 0))
    (local.set $ok)
    (local.set $v)
    (i32.add (local.get $v) (i32.shl (local.get $ok) (i32.const 8))))

  ;; Unbuffered: park recv, spawn send 42.
  (func (export "unbuffered_rendezvous") (result i32)
    (local $c (ref $hchan))
    (local $v i32)
    (local $ok i32)
    (local.set $c (call $makechan (i32.const 0)))
    (global.set $chan (local.get $c))
    (global.set $job (i32.const 1))
    (call $spawn)
    (call $chanrecv (local.get $c) (i32.const 1))
    (local.set $ok)
    (local.set $v)
    (local.get $v))

  ;; Two waiters: first recv parks, spawn sends 10 then 20, second recv gets 20.
  (func (export "two_waiters") (result i32)
    (local $c (ref $hchan))
    (local $a i32)
    (local $b i32)
    (local $ok i32)
    (local.set $c (call $makechan (i32.const 0)))
    (global.set $chan (local.get $c))
    (global.set $job (i32.const 2))
    (call $spawn)
    (call $chanrecv (local.get $c) (i32.const 1))
    (local.set $ok)
    (local.set $a)
    (call $chanrecv (local.get $c) (i32.const 1))
    (local.set $ok)
    (local.set $b)
    (i32.add (local.get $a) (local.get $b)))

  ;; Recv parks; close from _sched; recv observes ok=0.
  (func (export "recv_closed") (result i32)
    (local $c (ref $hchan))
    (local $v i32)
    (local $ok i32)
    (local.set $c (call $makechan (i32.const 0)))
    (global.set $chan (local.get $c))
    (global.set $job (i32.const 3))
    (call $spawn)
    (call $chanrecv (local.get $c) (i32.const 1))
    (local.set $ok)
    (local.set $v)
    (local.get $ok))
)
