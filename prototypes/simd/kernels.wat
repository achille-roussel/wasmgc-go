          (br $L))))
    (loop $T
      (if (i32.lt_u (local.get $i) (local.get $n))
        (then
          (if (i32.eq (array.get_u $bytes (local.get $a) (local.get $i)) (local.get $c))
            (then (local.set $cnt (i32.add (local.get $cnt) (i32.const 1)))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $T))))
    (local.get $cnt))

  (func $count_mem_body (param $n i32) (param $c i32) (result i32)
    (local $i i32)
    (local $lim i32)
    (local $cnt i32)
    (local $m i32)
    (local $needle v128)
    (local.set $needle (i8x16.splat (local.get $c)))
    (local.set $lim (i32.and (local.get $n) (i32.const -16)))
    (loop $L
      (if (i32.lt_u (local.get $i) (local.get $lim))
        (then
          (local.set $m (i8x16.bitmask (i8x16.eq (v128.load (local.get $i)) (local.get $needle))))
          (local.set $cnt (i32.add (local.get $cnt) (i32.popcnt (local.get $m))))
          (local.set $i (i32.add (local.get $i) (i32.const 16)))
          (br $L))))
    (loop $T
      (if (i32.lt_u (local.get $i) (local.get $n))
        (then
          (if (i32.eq (i32.load8_u (local.get $i)) (local.get $c))
            (then (local.set $cnt (i32.add (local.get $cnt) (i32.const 1)))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $T))))
    (local.get $cnt))

  (func (export "count_mem") (param $n i32) (param $c i32) (result i32)
    (call $count_mem_body (local.get $n) (local.get $c)))

  (func (export "count_bridge") (param $a (ref $bytes)) (param $n i32) (param $c i32) (result i32)
    (call $bridge_copy_all (local.get $a) (local.get $n))
    (call $count_mem_body (local.get $n) (local.get $c)))

  (func (export "count_v128arr") (param $a (ref $v128s)) (param $nbytes i32) (param $c i32) (result i32)
    (local $chunk i32)
    (local $nchunks i32)
    (local $cnt i32)
    (local $needle v128)
    (local.set $needle (i8x16.splat (local.get $c)))
    (local.set $nchunks (i32.div_u (local.get $nbytes) (i32.const 16)))
    (loop $L
      (if (i32.lt_u (local.get $chunk) (local.get $nchunks))
        (then
          (local.set $cnt (i32.add (local.get $cnt)
            (i32.popcnt (i8x16.bitmask (i8x16.eq (array.get $v128s (local.get $a) (local.get $chunk)) (local.get $needle))))))
          (local.set $chunk (i32.add (local.get $chunk) (i32.const 1)))
          (br $L))))
    (local.get $cnt))
)
